# RTSP Server — Environment Variables (secrets)
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Load before starting the server:
#   source .env && ./build/rtsp-mtx-server config.json

# Feishu (Lark) bot webhook URL for real-time event push
# Create at: Feishu group → Settings → Bots → Custom Bot → Webhook URL
FEISHU_WEBHOOK_URL=""
